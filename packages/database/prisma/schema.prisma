// ---------------------------------------------------------
// Communication, Social & Human Connection Intelligence (Phase 20)
// ---------------------------------------------------------

model CommunicationAccount {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String    // Email, Slack, WhatsApp mock
  accountName     String
  status          String    @default("active")
  
  threads         CommunicationThread[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CommunicationThread {
  id              String    @id @default(uuid())
  accountId       String
  account         CommunicationAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  participants    String    // JSON array or string
  subject         String?
  lastMessageAt   DateTime  @default(now())
  
  messages        CommunicationMessage[]
  drafts          MessageDraft[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CommunicationMessage {
  id              String    @id @default(uuid())
  threadId        String
  thread          CommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender          String
  content         String
  isRead          Boolean   @default(false)
  sentAt          DateTime  @default(now())
  
  createdAt       DateTime  @default(now())
}

model MessageDraft {
  id              String    @id @default(uuid())
  threadId        String
  thread          CommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  content         String
  recipient       String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FollowUp {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  person          String
  topic           String
  date            DateTime?
  status          String    @default("pending")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MeetingNote {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingId       String?   // Optional tie-in to Calendar event
  title           String
  content         String
  actionItems     String?   // JSON
  decisions       String?   // JSON
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

