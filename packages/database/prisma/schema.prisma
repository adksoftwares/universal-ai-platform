datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------
// User & Auth
// ---------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  language      String    @default("en")
  country       String?
  timezone      String?
  onboardingComplete Boolean @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  memories      Memory[]
  tasks         Task[]
  reminders     Reminder[]
  conversations Conversation[]
  goals         Goal[]
  notifications Notification[]
  documents     Document[]
  
  learningGoals LearningGoal[]
  careerProfile CareerProfile?
  skills        Skill[]
  projects      Project[]
  habits        Habit[]
  
  expenses      Expense[]
  budgets       Budget[]
  bills         Bill[]
  savingsGoals  SavingsGoal[]
  
  trips         Trip[]
  
  connectedServices ConnectedService[]
  externalActions   ExternalActionRecord[]
  
  healthProfile     HealthProfile?
  medications       Medication[]
  healthAppointments HealthAppointment[]
  wellnessRecords   WellnessRecord[]
  
  emergencyContacts EmergencyContact[]
  emergencyProfile  EmergencyProfile?
  emergencyPlans    EmergencyPlan[]
  safetyCheckIns    SafetyCheckIn[]
  locationShares    LocationShareEvent[]
  
  alertSubscriptions AlertSubscription[]
  
  serviceBookmarks   ServiceBookmark[]
  serviceApplications ServiceApplication[]
  
  educationRecords   EducationRecord[]
  courses            Course[]
  workExperiences    WorkExperience[]
  certifications     Certification[]
  generatedResumes   GeneratedResume[]
  jobOpportunities   JobOpportunity[]
  jobApplications    JobApplication[]
  
  contacts           Contact[]
  communications     CommunicationRecord[]
  meetings           MeetingRecord[]
  schedulingPref     SchedulingPreference?
  
  financialAccounts  FinancialAccount[]
  subscriptions      Subscription[]
  loans              Loan[]
  insurancePolicies  InsurancePolicy[]
  
  healthProviders    HealthProvider[]
  medicationLogs     MedicationLog[]
  healthMeasurements HealthMeasurement[]
  preventiveCare     PreventiveCareRecord[]
  
  studySessions      StudySession[]
  flashcards         Flashcard[]
  assessments        Assessment[]
  researchProjects   ResearchProject[]
  
  interviews         Interview[]
  offerComparisons   OfferComparison[]
  freelanceProjects  FreelanceProject[]
  businesses         Business[]
  
  assets             Asset[]
  netWorthSnapshots  NetWorthSnapshot[]
  
  activityRecords    ActivityRecord[]
  sleepRecords       SleepRecord[]
  nutritionRecords   NutritionRecord[]
  healthJournalEntries HealthJournalEntry[]
  
  savedPlaces        SavedPlace[]
  householdMembers   HouseholdMember[]
  
  wishlists          Wishlist[]
  shoppingOrders     ShoppingOrder[]
  
  vehicles           Vehicle[]
  commuteProfiles    CommuteProfile[]
  
  communicationAccounts CommunicationAccount[]
  followUps          FollowUp[]
  meetingNotes       MeetingNote[]
  
  knowledgeCollections KnowledgeCollection[]
  knowledgeNotes     KnowledgeNote[]
  quizzes            Quiz[]
  
  resumes            Resume[]
  portfolioProjects  PortfolioProject[]
  networkingRecords  NetworkingRecord[]
  
  socialGroups       SocialGroup[] @relation("GroupOwner")
  groupMemberships   GroupMember[] @relation("GroupMemberUser")
  socialEvents       SocialEvent[]
  giftPlans          GiftPlan[]
  safetyPlans        SafetyPlan[]
  activeLocationShares LocationShare[]
  
  civicApplications  CivicApplication[]
  licencePermits     LicencePermit[]
  civicComplaints    CivicComplaint[]
  
  healthRecords      HealthRecord[]
  symptomLogs        SymptomLog[]
  caregivers         CaregiverAccess[] @relation("Patient")
  
  transactionRules   TransactionRule[]
  investmentAssets   InvestmentAsset[]
  
  mistakeLogs        MistakeLog[]
  practiceSessions   PracticeSession[]
  certificates       Certificate[]
  
  communicationTemplates CommunicationTemplate[]
  blockedContacts    BlockedContact[]
  
  geofenceRules      GeofenceRule[]
  
  routines           Routine[]
  recipes            Recipe[]
  warranties         Warranty[]
  
  studyGroupMembers  StudyGroupMember[]
  researchPapers     ResearchPaper[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// AI Assistant & Memory
// ---------------------------------------------------------

model Memory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  type      String   // e.g., 'preference', 'fact', 'goal'
  category  String?  // e.g., 'personal', 'work'
  createdAt DateTime @default(now())
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // 'user', 'assistant', 'system'
  content        String
  createdAt      DateTime     @default(now())
}

// ---------------------------------------------------------
// Life Management
// ---------------------------------------------------------

model Task {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isCompleted Boolean   @default(false)
  dueDate     DateTime?
  priority    String    @default("medium") // low, medium, high
  category    String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Reminder {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  date        DateTime
  time        String?   // HH:mm
  isRecurring Boolean   @default(false)
  recurrence  String?   // 'daily', 'weekly', 'monthly'
  status      String    @default("upcoming") // upcoming, triggered, completed, cancelled

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Goal {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetDate  DateTime?
  progress    Int       @default(0) // percentage
  status      String    @default("active") // active, completed, abandoned
  
  milestones  GoalMilestone[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GoalMilestone {
  id          String    @id @default(uuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------
// System & Notifications
// ---------------------------------------------------------

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String    // reminder, task, goal, system, ai_suggestion
  title       String
  content     String?
  isRead      Boolean   @default(false)
  
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------
// Document Intelligence
// ---------------------------------------------------------

model Document {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  filename        String
  fileType        String    // application/pdf, image/jpeg, etc
  fileSize        Int       // bytes
  storagePath     String    // path or key to file storage
  
  category        String?   // 'Personal', 'Finance', 'Education', etc
  status          String    @default("processing") // uploaded, processing, ready, failed
  error           String?
  
  extractedText   String?
  aiSummary       String?
  
  importantDates  DocumentDate[]
  suggestedActions DocumentAction[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DocumentDate {
  id          String    @id @default(uuid())
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  date        DateTime
  description String
  source      String?   // 'Page 2'
  confidence  String    @default("identified") // identified, possible
  
  createdAt   DateTime  @default(now())
}

model DocumentAction {
  id          String    @id @default(uuid())
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actionType  String    // 'task', 'reminder'
  title       String
  deadline    DateTime?
  source      String?   // 'Page 2'
  
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------
// Learning & Development
// ---------------------------------------------------------

model LearningGoal {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  targetDate      DateTime?
  currentLevel    String?
  desiredLevel    String?
  preferredStyle  String?
  status          String         @default("active") // active, completed, paused
  
  plans           LearningPlan[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model LearningPlan {
  id              String         @id @default(uuid())
  learningGoalId  String
  goal            LearningGoal   @relation(fields: [learningGoalId], references: [id], onDelete: Cascade)
  title           String
  
  stages          LearningStage[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model LearningStage {
  id              String         @id @default(uuid())
  learningPlanId  String
  plan            LearningPlan   @relation(fields: [learningPlanId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          String         @default("not_started") // not_started, in_progress, completed, skipped
  order           Int            @default(0)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ---------------------------------------------------------
// Career
// ---------------------------------------------------------

model CareerProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  education       String?
  experience      String?
  certifications  String?
  careerGoals     String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Skill {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  category        String?
  currentLevel    String    @default("Beginner")
  targetLevel     String?
  
  evidences       SkillEvidence[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SkillEvidence {
  id              String    @id @default(uuid())
  skillId         String
  skill           Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title           String
  url             String?
  description     String?
  dateAchieved    DateTime?
  
  createdAt       DateTime  @default(now())
}

model Project {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  skillsUsed      String?
  role            String?
  outcomes        String?
  url             String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Habit {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  frequency       String    // daily, weekly
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ---------------------------------------------------------
// Finance
// ---------------------------------------------------------

model Expense {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Float
  currency        String    @default("USD")
  category        String
  date            DateTime
  description     String?
  paymentMethod   String?
  note            String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Budget {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        String
  amount          Float
  currency        String    @default("USD")
  period          String    @default("monthly")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Bill {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  amount          Float
  currency        String    @default("USD")
  dueDate         DateTime
  frequency       String    @default("monthly")
  category        String?
  status          String    @default("upcoming") // upcoming, due, paid, overdue
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SavingsGoal {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  targetAmount    Float
  currentAmount   Float     @default(0)
  currency        String    @default("USD")
  targetDate      DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ---------------------------------------------------------
// Travel
// ---------------------------------------------------------

model Trip {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  destination     String
  startDate       DateTime
  endDate         DateTime
  travelers       Int       @default(1)
  budget          Float?
  currency        String    @default("USD")
  notes           String?
  
  itinerary       ItineraryItem[]
  checklists      TravelChecklist[]
  destinations    TripDestination[]
  bookings        TravelBooking[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ItineraryItem {
  id              String    @id @default(uuid())
  tripId          String
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date            DateTime
  time            String?
  activity        String
  location        String?
  notes           String?
  estimatedCost   Float?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TravelChecklist {
  id              String    @id @default(uuid())
  tripId          String
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  item            String
  isCompleted     Boolean   @default(false)
  category        String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ---------------------------------------------------------
// Services & Integrations
// ---------------------------------------------------------

model ConnectedService {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String    // 'GoogleCalendar', 'MapsProvider'
  status          String    @default("connected")
  lastConnection  DateTime  @default(now())
  
  permissions     IntegrationPermission[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model IntegrationPermission {
  id              String    @id @default(uuid())
  serviceId       String
  service         ConnectedService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  scope           String    // 'view_calendar', 'create_events'
  granted         Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
}

model ExternalActionRecord {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  service         String
  actionType      String
  status          String    // success, failed
  details         String?
  
  createdAt       DateTime  @default(now())
}

// ---------------------------------------------------------
// Health
// ---------------------------------------------------------

model HealthProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodGroup      String?
  allergies       String?
  conditions      String?
  providers       String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Medication {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  dose            String?
  schedule        String?
  notes           String?
  
  logs            MedicationLog[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model HealthAppointment {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  provider        String
  location        String?
  notes           String?
  status          String    @default("scheduled")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model WellnessRecord {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime  @default(now())
  activity        String?
  sleepHours      Float?
  waterIntake     Float?
  mood            String?
  notes           String?
  
  createdAt       DateTime  @default(now())
}

// ---------------------------------------------------------
// Emergency & Safety
// ---------------------------------------------------------

model EmergencyContact {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  relationship    String?
  phone           String
  email           String?
  priority        Int       @default(0)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model EmergencyProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled         Boolean   @default(false)
  visibleFields   String?   // JSON array of what to show on emergency card
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model EmergencyPlan {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hazardType      String    // 'fire', 'flood', etc.
  meetingPoint    String?
  supplies        String?
  evacuationInfo  String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SafetyCheckIn {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledTime   DateTime
  status          String    @default("pending") // pending, safe, missed
  escalationPlan  String?   // JSON configuration of who to notify
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model LocationShareEvent {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient       String
  locationData    String    // JSON or coordinates
  expiresAt       DateTime
  
  createdAt       DateTime  @default(now())
}

// ---------------------------------------------------------
// Alerts
// ---------------------------------------------------------

model DisasterAlert {
  id              String    @id @default(uuid())
  source          String
  alertType       String
  severity        String
  region          String
  description     String
  issuedAt        DateTime
  expiresAt       DateTime?
  referenceUrl    String?
  
  createdAt       DateTime  @default(now())
}

model AlertSubscription {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  region          String
  severity        String    // minimum severity to alert
  
  createdAt       DateTime  @default(now())
}

// ---------------------------------------------------------
// Global Citizen Services
// ---------------------------------------------------------

model Jurisdiction {
  id              String    @id @default(uuid())
  country         String
  countryCode     String
  region          String?
  level           String    // national, state, local
  
  services        GovernmentService[]
  
  createdAt       DateTime  @default(now())
}

model GovernmentService {
  id              String    @id @default(uuid())
  jurisdictionId  String
  jurisdiction    Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  name            String
  category        String
  authority       String
  description     String
  eligibility     String?
  processingTime  String?
  fees            String?
  
  sources         ServiceSource[]
  requirements    ServiceRequirement[]
  bookmarks       ServiceBookmark[]
  applications    ServiceApplication[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ServiceSource {
  id              String    @id @default(uuid())
  serviceId       String
  service         GovernmentService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  url             String
  lastVerified    DateTime
  status          String    // verified, needs_verification, outdated
  
  createdAt       DateTime  @default(now())
}

model ServiceRequirement {
  id              String    @id @default(uuid())
  serviceId       String
  service         GovernmentService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  type            String    // document, prerequisite, step
  description     String
  isMandatory     Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
}

model ServiceBookmark {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String
  service         GovernmentService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
}

model ServiceApplication {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String
  service         GovernmentService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  referenceNumber String?
  status          String    // drafted, submitted, approved, rejected
  submittedAt     DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ---------------------------------------------------------
// Education Management
// ---------------------------------------------------------

model EducationRecord {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution     String
  qualification   String
  field           String?
  startDate       DateTime?
  endDate         DateTime?
  status          String    @default("In Progress") // In Progress, Completed
  achievements    String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Course {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  provider        String?
  code            String?
  instructor      String?
  credits         Float?
  status          String    @default("Active") // Planned, Active, Completed, Paused, Dropped
  
  subjects        Subject[]
  lessons         Lesson[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Subject {
  id              String    @id @default(uuid())
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name            String
  notes           String?
  
  exams           Exam[]
  topics          Topic[]
  studySessions   StudySession[]
  studyGroups     StudyGroup[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Exam {
  id              String    @id @default(uuid())
  subjectId       String
  subject         Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title           String
  date            DateTime
  location        String?
  topics          String?
  status          String    @default("Upcoming") // Upcoming, Completed
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ---------------------------------------------------------
// Career Tracking
// ---------------------------------------------------------

model WorkExperience {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employer        String
  role            String
  startDate       DateTime
  endDate         DateTime?
  responsibilities String?
  achievements    String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Certification {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  provider        String
  dateObtained    DateTime?
  expiryDate      DateTime?
  credentialId    String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GeneratedResume {
